# Paper preset — copy to .env on first setup (optional if using repo defaults):
#   cp .env.example .env
#
# Then: uv sync && mkdir -p data && uv run scalping --run

SCALPING_ENVIRONMENT=paper
SCALPING_CONTROL_TOKEN=paper-ctrl
SCALPING_DASHBOARD_UNKILL_TOKEN=paper-unkill

SCALPING_RUN_SYMBOLS=auto
SCALPING_UNIVERSE_MAX_SYMBOLS=300
SCALPING_UNIVERSE_MIN_QUOTE_VOLUME_USDT=100000
SCALPING_UNIVERSE_MAX_SPREAD_BPS=10
SCALPING_UNIVERSE_MIN_HISTORY_DAYS=0
SCALPING_WARM_REGISTRY=false

# Webshare (or any HTTP proxy). Prefer rotating endpoint while your VPS IP is banned:
#   SCALPING_HTTP_PROXY=http://USER-rotate:PASS@p.webshare.io:80
# Or paste many direct proxies (comma-separated); one sticky pick per process:
#   SCALPING_HTTP_PROXIES=http://u:p@1.2.3.4:80,http://u:p@5.6.7.8:80
SCALPING_HTTP_PROXY=
SCALPING_HTTP_PROXIES=

# Dashboard (local / SSH tunnel)
SCALPING_DASHBOARD_HOST=127.0.0.1
SCALPING_DASHBOARD_PORT=8000
SCALPING_DASHBOARD_CORS_ORIGIN=http://localhost:5173
